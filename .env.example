# Server port & production cookie signing secret
PORT=3000
APP_URL="http://localhost:3000"
SESSION_SECRET=

# Supabase Configuration (External PostgreSQL + Storage)
# Leave empty to run immediately with built-in local SQLite (.data/ramady_platform.sqlite)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin Room Security Passcode (Server-side verification only)
ADMIN_ACCESS_CODE=

# Optional Cron Secret for external scheduled triggers (e.g. Vercel Cron)
CRON_SECRET=
